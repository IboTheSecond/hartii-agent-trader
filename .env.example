# Copy to .env and fill in. Never commit the real file — .env* is gitignored.
# Full description of each var: INTERFACES.md#env

# --- required for LIVE trading only (never required in paper mode) ---
# HARTII_AGENT_KEY=
# HARTII_AGENT_KEY_FILE=
HARTII_VAULT_ADDRESS=

# --- reporting ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_URL=

# --- overrides (all have sane defaults — see INTERFACES.md#env) ---
HARTII_API_BASE=https://hartiilabs.com
HARTII_RPC_URL=https://rpc.quai.network/cyprus1
HARTII_PROFILE=reckless
HARTII_PAPER=1
HARTII_DRY_RUN=
HARTII_MAX_ACTIONS_PER_CYCLE=3
HARTII_CYCLE_INTERVAL_MS=300000
HARTII_LAUNCHES_ENABLED=
HARTII_MAX_PRICE_IMPACT_PCT=
HARTII_KILL_SWITCH_FILE=state/STOP
HARTII_STATE_DIR=state/
